package com.jai.agent

import android.content.Context
import org.json.JSONObject

class LearnerProfileManager(context: Context) {
    private val prefs = context.getSharedPreferences("jai_learner_profile", Context.MODE_PRIVATE)

    fun recordInteraction(topic: String, wasConceptUnderstood: Boolean) {
        val data = JSONObject(prefs.getString("profile_data", "{}") ?: "{}")
        val score = data.optInt(topic, 50)
        
        // Adjust skill estimate
        val updatedScore = if (wasConceptUnderstood) (score + 10).coerceAtMost(100) 
                           else (score - 10).coerceAtLeast(0)
                           
        data.put(topic, updatedScore)
        prefs.edit().putString("profile_data", data.toString()).apply()
    }

    fun getProfileJson(): String {
        return prefs.getString("profile_data", """
            {"Logic": 65, "Math": 50, "Visual_Reading": 70, "Patience_Level": "High"}
        """.trimIndent()) ?: "{}"
    }
}
